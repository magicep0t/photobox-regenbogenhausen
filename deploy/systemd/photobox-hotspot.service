[Unit]
Description=Photobox guest hotspot for phones (hostapd)
# runs while the USB Wi-Fi stick is plugged in (named by 10-photobox-guestwifi.link)
BindsTo=sys-subsystem-net-devices-guestwifi.device
After=sys-subsystem-net-devices-guestwifi.device

[Service]
Type=exec
RuntimeDirectory=photobox-hotspot
RuntimeDirectoryMode=0700
# Raspberry Pi OS soft-blocks new Wi-Fi devices until they are unblocked
ExecStartPre=/usr/sbin/rfkill unblock wlan
ExecStartPre=/usr/sbin/nft -f /opt/photobox/deploy/hotspot/hotspot.nft
ExecStartPre=/usr/bin/python3 /opt/photobox/deploy/hotspot/hostapd-conf.py /etc/photobox/config.toml /run/photobox-hotspot/hostapd.conf
ExecStart=/usr/sbin/hostapd /run/photobox-hotspot/hostapd.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=sys-subsystem-net-devices-guestwifi.device
