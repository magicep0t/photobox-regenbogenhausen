[Unit]
Description=Photobox kiosk (cage + Chromium on tty1)
Wants=photobox.service
After=photobox.service systemd-user-sessions.service plymouth-quit-wait.service
# The kiosk takes over tty1 instead of the login console.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=photobox
Group=photobox
# A PAM/logind session gives cage access to the display and input devices.
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=HOME=/var/lib/photobox

# Wait until the backend answers, then start Chromium full-screen.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do curl -sf http://127.0.0.1:8000/api/health >/dev/null && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/cage -d -- /usr/bin/chromium \
  --ozone-platform=wayland \
  --kiosk \
  --app=http://127.0.0.1:8000/?kiosk=1 \
  --user-data-dir=/var/lib/photobox/chromium \
  --password-store=basic \
  --no-first-run \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --disable-features=TranslateUI,Translate \
  --disable-pinch \
  --overscroll-history-navigation=0 \
  --autoplay-policy=no-user-gesture-required \
  --check-for-update-interval=31536000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
